balance = 10000

deposits = []
withdrawals = []


def check_balance():
    print("\nCurrent Balance: ₹", balance)


def deposit_money():
    global balance

    amount = float(input("Enter deposit amount: "))

    if amount > 0:
        balance += amount
        deposits.append(amount)

        print("Deposit successful.")
        print("Current Balance: ₹", balance)

    else:
        print("Enter a valid amount.")


def withdraw_money():
    global balance

    amount = float(input("Enter withdrawal amount: "))

    if amount <= 0:
        print("Enter a valid amount.")

    elif amount > balance:
        print("Insufficient balance.")

    else:
        balance -= amount
        withdrawals.append(amount)

        print("Withdrawal successful.")
        print("Current Balance: ₹", balance)


def transaction_analysis():

    total_deposits = sum(deposits)
    total_withdrawals = sum(withdrawals)

    print("\n===== TRANSACTION ANALYSIS =====")

    print("Total Deposits: ₹", total_deposits)
    print("Total Withdrawals: ₹", total_withdrawals)
    print("Number of Deposits:", len(deposits))
    print("Number of Withdrawals:", len(withdrawals))

    if len(deposits) > 0:
        print("Highest Deposit: ₹", max(deposits))
    else:
        print("No deposits made.")

    if len(withdrawals) > 0:
        print("Highest Withdrawal: ₹", max(withdrawals))
    else:
        print("No withdrawals made.")


while True:

    print("\n===== ATM SYSTEM =====")
    print("1. Check Balance")
    print("2. Deposit Money")
    print("3. Withdraw Money")
    print("4. Transaction Analysis")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        check_balance()

    elif choice == "2":
        deposit_money()

    elif choice == "3":
        withdraw_money()

    elif choice == "4":
        transaction_analysis()

    elif choice == "5":
        print("Thank you for using the ATM.")
        break

    else:
        print("Invalid choice.")
